<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>by.andd3dfx</groupId>
        <artifactId>db-pool-in-tests</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>db-pool-example</artifactId>
    <packaging>jar</packaging>
    <name>db-pool-example</name>
    <description>Example of wiring the test database pool library</description>

    <dependencies>
        <dependency>
            <groupId>by.andd3dfx</groupId>
            <artifactId>db-pool-library</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Print test + SLF4J output to console (otherwise some output may go to Surefire files) -->
                    <redirectTestOutputToFile>false</redirectTestOutputToFile>
                    <!-- ContainersLifecycleSupport reads a system property -->
                    <systemPropertyVariables>
                        <spring.profiles.active>it,testcontainer</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
